{
  "family": "laguna",
  "soc_family": "laguna",
  "keymint": "rust",
  "post_remove_ramdisk": [],
  "props": {
    "ro.recovery.rb_swap": "1",
    "ro.recovery.soc_family": "laguna",
    "ro.soc.model": "Tensor G5",
    "persist.sys.usb.config": "mtp,adb",
    "ro.hardware.keystore": "trusty",
    "ro.hardware.gatekeeper": "trusty",
    "ro.product.ab_ota_partitions": "abl,bl31,boot,cap,cpm,dbc,dbl,dram_init_0,dram_init_1,dram_init_2,dram_init_3,dram_init_4,dram_init_5,dram_init_6,dram_init_7,dram_init_8,dram_init_9,dram_phy,dtbo,gc,gdmc,gsa_bl1,gsa_fw,init_boot,modem,product,pvmfw,system,system_dlkm,system_ext,tzsw,vbmeta,vbmeta_system,vbmeta_vendor,vendor,vendor_boot,vendor_dlkm,vendor_kernel_boot",
    "ro.build.selinux": "0",
    "ro.boot.selinux": "permissive"
  },
  "default_kernel": "6.12",
  "kernels": {
    "6.12": {
      "cmdline": {
        "type": "arr",
        "value": [
          "workqueue.power_efficient=1",
          "f2fs.num_compress_pages=128",
          "fips140.load_sequential=1",
          "vh_sched.load_sequential=1",
          "spmi_smartdv.load_sequential=1",
          "regmap-goog-spmi.load_sequential=1",
          "max77779_pmic.load_sequential=1",
          "max77779_pmic_spmi.load_sequential=1",
          "max77779_pmic_pinctrl.load_sequential=1",
          "binder.impl=rust",
          "samsung_dma_heap.gcma_skip_heaps=gcma_camera_internal",
          "dyndbg=\"func alloc_contig_dump_pages +p\"",
          "cma_sysfs.experimental=Y",
          "cgroup.memory=nokmem",
          "init_on_alloc=0",
          "init_on_free=1",
          "rcupdate.rcu_expedited=1",
          "rcu_nocbs=all",
          "rcutree.enable_rcu_lazy",
          "swiotlb=noforce",
          "disable_dma32=on",
          "sysctl.kernel.sched_pelt_multiplier=4",
          "aoc_core.aoc_enable_gsa_boot=1",
          "rodata=on",
          "arm_smmu_v3_kvm.smc_s2=true",
          "kasan=off",
          "at24.write_timeout=100",
          "log_buf_len=1024K",
          "android_arch_task_struct_size=784",
          "bootconfig"
        ]
      },
      "bootconfig_append": [
        "androidboot.load_modules_parallel=true",
        "androidboot.boot_devices=3c400000.ufs"
      ],
      "prebuilt": {},
      "ko": {}
    }
  }
}
