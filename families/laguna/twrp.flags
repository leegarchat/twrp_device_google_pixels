# twrp.flags — Tensor G5 (laguna) | UFS @ 3c400000
# Derived from zuma flags; UFS re-pointed to 3c400000 per blazer stock fstab.
# + userdata_exp/zoned_device (laguna multi-device userdata members).
#
# mount point         fstype  device                                                             flags

# ============================================================
# 1. Dynamic logical partitions (in super, A/B via slotselect)
# ============================================================
/system              ext4    /dev/block/mapper/system                                           flags=display="System";logical;backup=1;slotselect
/system_ext          ext4    /dev/block/mapper/system_ext                                       flags=display="System Ext";logical;backup=1;slotselect
/system_dlkm         ext4    /dev/block/mapper/system_dlkm                                      flags=display="System DLKM (GKI kernel modules)";logical;backup=1;slotselect
/product             ext4    /dev/block/mapper/product                                          flags=display="Product";logical;backup=1;slotselect
/vendor              ext4    /dev/block/mapper/vendor                                           flags=display="Vendor";logical;backup=1;slotselect
/vendor_dlkm         ext4    /dev/block/mapper/vendor_dlkm                                      flags=display="Vendor DLKM (device kernel modules)";logical;backup=1;slotselect

# ============================================================
# 2. Metadata (FBE key wrapping) + Internal Storage
# ============================================================
/metadata            f2fs    /dev/block/platform/3c400000.ufs/by-name/metadata                  flags=display="Metadata (FBE crypto info)";backup=1;wipeingui;wrappedkey

# Internal Storage (/sdcard = /data/media/0) — file-based backup (tar snapshot, not disk image).
# OrangeFox archives user files (Photos, Downloads, etc.) without touching the rest of /data.
# Mechanism: usermrf (User Media Root Fuse) + fsflags=bind mount on /data/media/0.
/storage             ext4    /data/media/0                                                      flags=display="Internal Storage (Files / sdcard)";backup=1;usermrf;fsflags="bind";removable

# ============================================================
# 3. Boot images (A/B slotted, raw images)
# ============================================================
/boot                emmc    /dev/block/platform/3c400000.ufs/by-name/boot                      flags=slotselect;display="Boot Image";backup=1;flashimg=1
/init_boot           emmc    /dev/block/platform/3c400000.ufs/by-name/init_boot                 flags=slotselect;display="Init Boot (Generic Ramdisk)";backup=1;flashimg=1
/vendor_boot         emmc    /dev/block/platform/3c400000.ufs/by-name/vendor_boot                flags=slotselect;display="Vendor Boot (OrangeFox Recovery)";backup=1;flashimg=1
/vendor_kernel_boot  emmc    /dev/block/platform/3c400000.ufs/by-name/vendor_kernel_boot         flags=slotselect;display="Vendor Kernel Boot (GKI modules)";backup=1;flashimg=1
/dtbo                emmc    /dev/block/platform/3c400000.ufs/by-name/dtbo                      flags=slotselect;display="DTBO (Device Tree Overlay)";backup=1;flashimg=1

# ============================================================
# 4. Verified Boot metadata (A/B slotted)
# ============================================================
/vbmeta              emmc    /dev/block/platform/3c400000.ufs/by-name/vbmeta                    flags=slotselect;display="VBMeta (Verified Boot)";backup=1;flashimg=1
/vbmeta_system       emmc    /dev/block/platform/3c400000.ufs/by-name/vbmeta_system             flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor       emmc    /dev/block/platform/3c400000.ufs/by-name/vbmeta_vendor             flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1

# ============================================================
# 5. Modem / Radio firmware (A/B slotted, ~200 MB each)
# ============================================================
/modem               emmc    /dev/block/platform/3c400000.ufs/by-name/modem                     flags=slotselect;display="Modem (Radio Firmware)";backup=1

# ============================================================
# 6. Bootloader chain (reference only — backup/flash disabled: brick risk)
# NOTE: bl1/bl2/ldfw restored as inert — file/blob absence alone no longer
# trusted as GPT-absence proof (live dpm_a/_b on shiba proved it); final
# arbiter is a by-name listing from a live unit.
# ============================================================
/abl                 emmc    /dev/block/platform/3c400000.ufs/by-name/abl                       flags=display="ABL (Android Bootloader)"
/bl1                 emmc    /dev/block/platform/3c400000.ufs/by-name/bl1                       flags=display="BL1 (First-stage Bootloader)"
/bl2                 emmc    /dev/block/platform/3c400000.ufs/by-name/bl2                       flags=display="BL2 (Second-stage Bootloader)"
/bl31                emmc    /dev/block/platform/3c400000.ufs/by-name/bl31                      flags=display="BL31 (ARM Trusted Firmware)"
/pvmfw               emmc    /dev/block/platform/3c400000.ufs/by-name/pvmfw                     flags=display="PVMFW (Protected VM Firmware)"
/tzsw                emmc    /dev/block/platform/3c400000.ufs/by-name/tzsw                      flags=display="TZSW (TrustZone Software)"
/ldfw                emmc    /dev/block/platform/3c400000.ufs/by-name/ldfw                      flags=display="LDFW (Load Device Firmware / GSA)"

# ============================================================
# 7. Google Security Chip (reference only — backup/flash disabled)
# NOTE: gsa/gcf/pbl restored as inert (same dpm reasoning); gsa_fw is the
# G5-proven name (gsa_fw.img + FBPK TOC), bare gsa kept until by-name proof.
# ============================================================
/gsa                 emmc    /dev/block/platform/3c400000.ufs/by-name/gsa                       flags=display="GSA (Google Security Chip Firmware)"
/gsa_bl1             emmc    /dev/block/platform/3c400000.ufs/by-name/gsa_bl1                   flags=display="GSA BL1 (Security Chip 1st-stage)"
/gcf                 emmc    /dev/block/platform/3c400000.ufs/by-name/gcf                       flags=display="GCF (Google Compute Firmware)"
/pbl                 emmc    /dev/block/platform/3c400000.ufs/by-name/pbl                       flags=display="PBL (Primary Bootloader)"

# ============================================================
# 8. Critical persistent non-slotted partitions
# CAUTION: efs contains IMEI + modem calibration — backup before flashing!
# ============================================================
/efs                 ext4    /dev/block/platform/3c400000.ufs/by-name/efs                       flags=display="EFS (IMEI + Modem Calibration)";backup=1
/efs_backup          ext4    /dev/block/platform/3c400000.ufs/by-name/efs_backup                flags=display="EFS Backup";backup=1
/persist             ext4    /dev/block/platform/3c400000.ufs/by-name/persist                   flags=display="Persist (DRM keys + WiFi calibration)";backup=1
/fips                emmc    /dev/block/platform/3c400000.ufs/by-name/fips                      flags=display="FIPS (Cryptographic Module)";backup=1
/trusty_persist      emmc    /dev/block/platform/3c400000.ufs/by-name/trusty_persist             flags=display="Trusty Persist (TEE persistent data)";backup=1
/trusty_userdata     emmc    /dev/block/platform/3c400000.ufs/by-name/trusty_userdata            flags=display="Trusty User Data (TEE + KeyMint)";backup=1
/modem_userdata      emmc    /dev/block/platform/3c400000.ufs/by-name/modem_userdata             flags=display="Modem User Data";backup=1

# ============================================================
# 9. Misc non-critical / state
# ============================================================
/misc                emmc    /dev/block/platform/3c400000.ufs/by-name/misc                      flags=display="Misc (OTA state, bootloader messages)";backup=1

# ============================================================
# 10. External Storage (USB OTG)
# ============================================================
/usb_otg             auto    /dev/block/sdd1                                                    flags=display="USB OTG (External Drive)";storage;wipeingui;removable;fsflags="utf8"

# ============================================================
# 11. Bootloader non-A/B persistent partitions
# ============================================================
# Device Info: stores bootloader unlock state. Backup before experimenting with
# bootloader or advanced options. Flashing an incorrect devinfo can soft-brick.
/devinfo             emmc    /dev/block/platform/3c400000.ufs/by-name/devinfo                   flags=display="DevInfo (unlock state)";backup=1

# Bootloader environment variables (ABL command-line / persistent flags).
/blenv               emmc    /dev/block/platform/3c400000.ufs/by-name/blenv                     flags=display="BL Env (bootloader params)";backup=1

# DRAM training calibration data. Restored automatically by bootloader on cold
# boot; losing it adds ~200ms to boot (not critical, but nice to keep).
/dram_train          emmc    /dev/block/platform/3c400000.ufs/by-name/dram_train                flags=display="DRAM Training Data";backup=1

# Factory Reset Protection — contains Google account binding token.
# Backup only if you need to restore FRP state; flashing zeros clears FRP lock.
/frp                 emmc    /dev/block/platform/3c400000.ufs/by-name/frp                       flags=display="FRP (Factory Reset Protection)";backup=1

# Kernel crash log ring buffer (written by pstore/blk).
# Read-only in practice; backup=1 allows saving a crash dump image.
/klog                emmc    /dev/block/platform/3c400000.ufs/by-name/klog                      flags=display="KLog (kernel crash log)";backup=1

# Partition info / GPT supplemental metadata used by bootloader.
/pinfo               emmc    /dev/block/platform/3c400000.ufs/by-name/pinfo                     flags=display="PInfo (partition metadata)";backup=1

# UFS internal device config / health data (pre-EoL counters etc.).
/ufs_internal        emmc    /dev/block/platform/3c400000.ufs/by-name/ufs_internal              flags=display="UFS Internal (device config)";backup=1

# ============================================================
# ============================================================
# 12. Tensor G5 power/clock/DRAM/security firmware (reference only —
# backup/flash disabled: brick risk). Proven by image-mustang-*.zip
# contents + FBPK bootloader TOC (2026-09).
# ============================================================
/gsa_fw              emmc    /dev/block/platform/3c400000.ufs/by-name/gsa_fw                    flags=display="GSA FW (Security Chip Firmware, Tensor G5)"
/cap                 emmc    /dev/block/platform/3c400000.ufs/by-name/cap                       flags=display="CAP (Tensor G5 firmware)"
/cpm                 emmc    /dev/block/platform/3c400000.ufs/by-name/cpm                       flags=display="CPM (Tensor G5 firmware)"
/dbc                 emmc    /dev/block/platform/3c400000.ufs/by-name/dbc                       flags=display="DBC (Tensor G5 firmware)"
/dbl                 emmc    /dev/block/platform/3c400000.ufs/by-name/dbl                       flags=display="DBL (Tensor G5 firmware)"
/dram_phy            emmc    /dev/block/platform/3c400000.ufs/by-name/dram_phy                  flags=display="DRAM PHY (DRAM controller firmware)"
/dram_init_0         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_0               flags=display="DRAM Init 0 (DRAM controller firmware)"
/dram_init_1         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_1               flags=display="DRAM Init 1 (DRAM controller firmware)"
/dram_init_2         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_2               flags=display="DRAM Init 2 (DRAM controller firmware)"
/dram_init_3         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_3               flags=display="DRAM Init 3 (DRAM controller firmware)"
/dram_init_4         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_4               flags=display="DRAM Init 4 (DRAM controller firmware)"
/dram_init_5         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_5               flags=display="DRAM Init 5 (DRAM controller firmware)"
/dram_init_6         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_6               flags=display="DRAM Init 6 (DRAM controller firmware)"
/dram_init_7         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_7               flags=display="DRAM Init 7 (DRAM controller firmware)"
/dram_init_8         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_8               flags=display="DRAM Init 8 (DRAM controller firmware)"
/dram_init_9         emmc    /dev/block/platform/3c400000.ufs/by-name/dram_init_9               flags=display="DRAM Init 9 (DRAM controller firmware)"
/gc                  emmc    /dev/block/platform/3c400000.ufs/by-name/gc                        flags=display="GC (Tensor G5 firmware)"
/gdmc                emmc    /dev/block/platform/3c400000.ufs/by-name/gdmc                      flags=display="GDMC (Tensor G5 firmware)"
# NOTE: no system_other partition on file — image zips carry system_other.img
# as flash content (fastboot --slot-other), live by-name has no such node.

# ============================================================
# NOTE: /dpm is real (live-proven: dpm_a/_b in shiba by-name) though it never
# ships in zips/TOCs (factory-fused?). Reference only — no backup/flash.
/dpm                 emmc    /dev/block/platform/3c400000.ufs/by-name/dpm                       flags=display="DPM (power management fw)"
# 13. Super partition (raw physical container for logical partitions)
# WARNING: backing up super produces a ~10 GB raw image that contains ALL
# logical partitions combined. Prefer backing up individual logical partitions
# (System, Vendor, etc.) above unless you specifically need a monolithic image.
# ============================================================
/super               emmc    /dev/block/platform/3c400000.ufs/by-name/super                     flags=display="Super (all logical partitions raw)";backup=1;flashimg=1

# ============================================================
# 14. Laguna multi-device userdata members (physical, behind dm-default-key)
# Display + backup only: flashed/restored exclusively via the dm mapper paths.
# ============================================================
/userdata_exp        emmc    /dev/block/platform/3c400000.ufs/by-name/userdata_exp               flags=display="Userdata Exp (F2FS expansion device)";backup=1
/zoned_device        emmc    /dev/block/platform/3c400000.ufs/by-name/zoned_device               flags=display="Zoned Device (F2FS zoned LU)";backup=1
