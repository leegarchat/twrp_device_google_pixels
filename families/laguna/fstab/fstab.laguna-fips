# Android fstab file.
#
#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/platform/3c400000.ufs/by-name/boot            /boot                       emmc    defaults                 slotselect,avb=boot,first_stage_mount
/dev/block/platform/3c400000.ufs/by-name/init_boot       /init_boot                  emmc    defaults                 slotselect,avb=init_boot,first_stage_mount
/dev/block/platform/3c400000.ufs/by-name/misc            /misc                       emmc    defaults                 wait
#/dev/block/platform/3c400000.ufs/by-name/pvmfw           /pvmfw                      emmc    defaults                 wait,slotselect,avb=pvmfw,first_stage_mount
/dev/block/platform/3c400000.ufs/by-name/vbmeta          /vbmeta                     emmc    defaults                 slotselect,first_stage_mount
/devices/platform/*/c400000.dwc3*                                 auto                        vfat    defaults                 voldmanaged=usb:auto
# Android fstab file.
#
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#
#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>  <fs_mgr_flags>
system                                                   /system                     ext4    noatime,ro               wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
# During compliance testing, the previous line would fail (because GSI is ext4), and the next line would be used to mount GSI.
system                                                   /system                     ext4    noatime,ro,barrier=1     wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                              /system_dlkm                ext4    noatime,ro               wait,slotselect,avb=vbmeta_system,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
system_ext                                               /system_ext                 ext4    noatime,ro               wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
product                                                  /product                    ext4    noatime,ro               wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
vendor                                                   /vendor                     ext4    noatime,ro               wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                              /vendor_dlkm                ext4    noatime,ro               wait,slotselect,avb=vbmeta,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
# Android fstab file.
#
#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/platform/3c400000.ufs/by-name/metadata        /metadata                   f2fs    noatime,nosuid,nodev,sync  wait,check,formattable,first_stage_mount
/dev/block/platform/3c400000.ufs/by-name/metadata        /metadata                   ext4    noatime,nosuid,nodev,data=journal,commit=1    wait,check,formattable,first_stage_mount,metadata_csum
/dev/block/platform/3c400000.ufs/by-name/userdata        /data                       f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,reserve_node=8192,resgid=1065,fsync_mode=nobarrier,inlinecrypt,atgc,checkpoint_merge,compress_cache    latemount,wait,check,quota,formattable,sysfs_path=/dev/sys/block/bootdevice,checkpoint=fs,reservedsize=128M,fscompress,readahead_size_kb=128,fileencryption=aes-256-xts,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption,device=zoned:/dev/block/by-name/zoned_device,device=exp_alias:/dev/block/by-name/userdata_exp.ai
/dev/block/platform/3c400000.ufs/by-name/userdata        /data                       ext4     noatime,nosuid,nodev,inlinecrypt    latemount,wait,check,quota,formattable,reservedsize=128M,readahead_size_kb=128,fileencryption=aes-256-xts,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption
