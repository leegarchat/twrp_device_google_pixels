# Android fstab file.
#
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#
#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>  <fs_mgr_flags>
system                                                   /system                     erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
# During compliance testing, the previous line would fail (because GSI is ext4), and the next line would be used to mount GSI.
system                                                   /system                     ext4    ro,barrier=1             wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                              /system_dlkm                ext4    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                              /system_dlkm                erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system_ext                                               /system_ext                 ext4    noatime,ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
system_ext                                               /system_ext                 erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
product                                                  /product                    ext4    noatime,ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
product                                                  /product                    erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
vendor                                                   /vendor                     ext4    noatime,ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
vendor                                                   /vendor                     erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                              /vendor_dlkm                ext4    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                              /vendor_dlkm                erofs    ro                       wait,slotselect,logical,first_stage_mount,readahead_size_kb=128
/dev/block/platform/3c2d0000.ufs/by-name/boot            /boot                       emmc    defaults                 slotselect,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/init_boot       /init_boot                  emmc    defaults                 slotselect,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/misc            /misc                       emmc    defaults                 wait
/dev/block/platform/3c2d0000.ufs/by-name/metadata        /metadata                   f2fs    noatime,nosuid,nodev,sync  wait,check,formattable,first_stage_mount
#/dev/block/platform/3c2d0000.ufs/by-name/pvmfw           /pvmfw                      emmc    defaults                 wait,slotselect,avb=pvmfw,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/userdata        /data                       f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt,atgc,checkpoint_merge,compress_cache    latemount,wait,check,quota,formattable,sysfs_path=/dev/sys/block/bootdevice,checkpoint=fs,reservedsize=128M,fscompress,readahead_size_kb=128,fileencryption=:aes-256-hctr2:inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,device=zoned:/dev/block/by-name/zoned_device,device=exp_alias:/dev/block/by-name/userdata_exp.ai,device=exp:/dev/block/by-name/userdata_exp.super,device=exp_alias:/dev/block/by-name/userdata_exp.zram,device=exp:/dev/block/by-name/userdata_exp.1g,device=exp_alias:/dev/block/by-name/userdata_exp.filepin,device=exp_alias:/dev/block/by-name/userdata_exp.ai_256m
/dev/block/platform/3c2d0000.ufs/by-name/vbmeta          /vbmeta                     emmc    defaults                 slotselect,first_stage_mount
/devices/platform/*/a210000.dwc3*                                 auto                        vfat    defaults                 voldmanaged=usb:auto
