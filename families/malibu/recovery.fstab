# recovery.fstab — Partition layout for Malibu SoC (Tensor G6) Pixel devices.
# UFS controller at 3c2d0000, DWC3 USB at a210000.
# Shared across shiba/husky/akita (same SoC, same partition layout).
#
# FBE encryption: aes-256-hctr2 with wrappedkey_v0 (hardware-wrapped keys via KeyMint)
# Metadata encryption: wrappedkey_v0 via Trusty TEE
#
# Android fstab file.
# Logical partitions ship erofs-first twins exactly like stock
# vendor/etc/fstab.malibu (erofs, then the ext4/GSI fallback line):
# stock system/vendor/product are EROFS on Tensor G6, ext4-only entries
# fail the mount and cascade into decrypt/backup failures.
#<src>                                                   <mnt_point>          <type>  <mnt_flags and options>                    <fs_mgr_flags>
system                                                   /system              erofs   ro                                        wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system                                                   /system              ext4    ro,barrier=1                              wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                              /system_dlkm         erofs   ro                                        wait,slotselect,avb=vbmeta_system,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                              /system_dlkm         ext4    ro                                        wait,slotselect,avb=vbmeta_system,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
system_ext                                               /system_ext          erofs   ro                                        wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
product                                                  /product             erofs   ro                                        wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
vendor                                                   /vendor              erofs   ro                                        wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                              /vendor_dlkm         erofs   ro                                        wait,slotselect,avb=vbmeta,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                              /vendor_dlkm         ext4    ro                                        wait,slotselect,avb=vbmeta,avb_keys=no_such_key,logical,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/boot            /boot                emmc    defaults                                  slotselect,avb=boot,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/init_boot       /init_boot           emmc    defaults                                  slotselect,avb=init_boot,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/misc            /misc                emmc    defaults                                  wait
/dev/block/platform/3c2d0000.ufs/by-name/metadata        /metadata            f2fs    noatime,nosuid,nodev,sync                 wait,check,formattable,first_stage_mount
/dev/block/platform/3c2d0000.ufs/by-name/userdata        /data                f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt,atgc,checkpoint_merge,compress_cache    latemount,wait,check,quota,formattable,sysfs_path=/dev/sys/block/bootdevice,checkpoint=fs,reservedsize=128M,fscompress,readahead_size_kb=128,fileencryption=:aes-256-hctr2:inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,device=zoned:/dev/block/by-name/zoned_device,device=exp_alias:/dev/block/by-name/userdata_exp.ai,device=exp:/dev/block/by-name/userdata_exp.super,device=exp_alias:/dev/block/by-name/userdata_exp.zram,device=exp:/dev/block/by-name/userdata_exp.1g,device=exp_alias:/dev/block/by-name/userdata_exp.filepin,device=exp_alias:/dev/block/by-name/userdata_exp.ai_256m
/dev/block/platform/3c2d0000.ufs/by-name/vbmeta          /vbmeta              emmc    defaults                                  slotselect,first_stage_mount
/devices/platform/a210000.usb*                          auto                 auto    defaults                 voldmanaged=usb:auto
