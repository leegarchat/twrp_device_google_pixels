// Pre-rendered vendor fstab for gs201 (Tensor G2, also reused by gs101).
// Rendered once from pixel-source/conf-gs201/fstab.gs201.in with the same
// sed substitutions the genrules used (normal + fips). No build-time
// codegen: plain prebuilt_etc with the historical module names, so
// device.mk PRODUCT_PACKAGES lines are unchanged.
prebuilt_etc {
    name: "fstab.gs201",
    src: "fstab.gs201",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "fstab.gs201-fips",
    src: "fstab.gs201-fips",
    vendor: true,
    vendor_ramdisk_available: true,
}
