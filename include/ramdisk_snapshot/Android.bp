// Soong build for TWRP/OrangeFox recovery.
//
// Rust port of the ramdisk snapshot dumper (previously ramdisk_snapshot.c).
// Same module name, so PRODUCT_PACKAGES and the init.rc/init.cpp call sites
// (/system/bin/ramdisk_snapshot) are unchanged.
rust_binary {
    name: "ramdisk_snapshot",
    srcs: ["src/main.rs"],
    crate_name: "ramdisk_snapshot",
    recovery: true,
    rustlibs: [
        "liblibc",
    ],
    // Static std/rlib linkage like recovery-tensor-daemon: the binary must
    // run pre-unpack from the ramdisk base (first-stage-adjacent, before
    // /lgz_cluster.lgz is unpacked), so it cannot depend on libstd.dylib.so.
    prefer_rlib: true,
}
