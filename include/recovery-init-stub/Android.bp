// Soong build for OrangeFox recovery.
//
// Static PID 1 stub occupying /system/bin/init. The real AOSP init lives at
// /system/bin/init.real INSIDE /lgz_cluster.lgz. Same pattern as
// ramdisk_snapshot: recovery binary, rlib std, only liblibc — it must run
// before the cluster is unpacked, so it cannot depend on libstd.dylib.so.
rust_binary {
    name: "recovery_init_stub",
    srcs: ["src/main.rs"],
    crate_name: "recovery_init_stub",
    recovery: true,
    rustlibs: [
        "liblibc",
    ],
    prefer_rlib: true,
}
