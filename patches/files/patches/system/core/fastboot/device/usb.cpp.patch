+// Kick a wedged FunctionFS transport back to life (mirrors the kick in
+// adb/daemon/usb_legacy.cpp). A host-side abort mid-transfer (killed fastboot
+// client, dropped cable, SIGPIPE) can leave the bulk endpoints in a state
+// where no further read/write ever completes: the daemon stays alive and USB
+// stays enumerated, but it never answers again. Recovery clears any endpoint
+// halt; the caller (ClientUsbTransport::Reset) then drops and reopens both
+// bulk fds and rebuilds the aio contexts. The control fd is deliberately left
+// open, so no descriptor rewrite (EBUSY while bound) is needed and the host
+// never re-enumerates.
+void ClearEndpointHalt(usb_handle* h) {
+    if (h->bulk_in.get() >= 0) {
+        if (ioctl(h->bulk_in.get(), FUNCTIONFS_CLEAR_HALT) < 0) {
+            PLOG(WARNING) << "failed to clear halt on bulk-in endpoint";
+        }
+    }
+    if (h->bulk_out.get() >= 0) {
+        if (ioctl(h->bulk_out.get(), FUNCTIONFS_CLEAR_HALT) < 0) {
+            PLOG(WARNING) << "failed to clear halt on bulk-out endpoint";
+        }
+    }
+}
+
+void ReinitAioBlocks(usb_handle* h) {
+    if (h->aio_type != AIOType::AIO) {
+        return;
+    }
+    TEMP_FAILURE_RETRY(io_destroy(h->read_aiob.ctx));
+    TEMP_FAILURE_RETRY(io_destroy(h->write_aiob.ctx));
+    aio_block_init(&h->read_aiob, h->read_aiob.iocbs.size());
+    aio_block_init(&h->write_aiob, h->write_aiob.iocbs.size());
+}
 
