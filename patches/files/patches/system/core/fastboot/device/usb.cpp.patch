+        // Bound the write wait: a bulk-IN transfer only completes while the
+        // host keeps polling, so 10s with zero completions means the host is
+        // gone (killed client, dropped cable). Without this, a dead host
+        // parks the daemon in io_getevents forever. Reads stay unbounded:
+        // idling for hours waiting for the next command is normal.
+        struct timespec timeout_ts {};
+        struct timespec* timeout_ptr = nullptr;
+        if (!read) {
+            timeout_ts.tv_sec = 10;
+            timeout_ptr = &timeout_ts;
+        }
+        int got_events = TEMP_FAILURE_RETRY(io_getevents(aiob->ctx, num_bufs, num_bufs,
+                                                          aiob->events.data(), timeout_ptr));
+        if (got_events < num_bufs) {
+            if (!read && got_events == 0) {
+                LOG(ERROR) << "aio: write stalled, host appears gone";
+            } else {
+                PLOG(ERROR) << "aio: got error waiting " << (read ? "read" : "write");
