+    // Fox (malibu zoned userdata): the key location follows PROVISIONING,
+    // not current LUN visibility. When the zoned LUN enumerates late (or
+    // the libfstab access() gate missed it), the caller reads the base
+    // dir while the key was provisioned under <dir>/default/ (and vice
+    // versa on legacy-provisioned units). Probe the alternate location
+    // when the primary is absent — read-only, first-hit-wins. Field case:
+    // grizzly reads base/key (absent) while kodiak reads default/key
+    // (present), identical binaries.
+    if (!pathExists(dir)) {
+        std::string alt = dir;
+        const std::string dflt = "/default/key";
+        if (dir.size() > dflt.size() && dir.compare(dir.size() - dflt.size(), dflt.size(), dflt) == 0) {
+            alt = dir.substr(0, dir.size() - dflt.size()) + "/key";
+        } else {
+            alt = metadata_key_dir + "/default/key";
+        }
+        if (pathExists(alt)) {
+            LOG(INFO) << "Fox: primary key absent, using alternate: " << alt;
+            dir = alt;
+        } else {
+            // Diagnostics for the next flog: list what IS in the key dir
+            // so provisioning state is readable instead of guessed.
+            LOG(ERROR) << "Fox: key absent in both " << dir << " and " << alt << "; contents of "
+                       << metadata_key_dir << ":";
+            auto d = opendir(metadata_key_dir.c_str());
+            if (d) {
+                struct dirent* e;
+                while ((e = readdir(d)) != nullptr) {
+                    std::string n = e->d_name;
+                    if (n != "." && n != "..")
+                        LOG(ERROR) << "Fox: keydir entry: " << n;
+                }
+                closedir(d);
+            } else {
+                LOG(ERROR) << "Fox: cannot opendir " << metadata_key_dir;
+            }
+        }
+    }
