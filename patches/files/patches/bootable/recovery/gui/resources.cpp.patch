+// Fox AIO runtime R/B-swap selector (same contract as fox_rb_swap() in
+// minuitwrp/graphics.cpp and minuitwrp/resources.cpp:
+// ro.recovery.rb_swap="1" for malibu/laguna, "0" otherwise, absent = no
+// swap). Separate TU, same one-line cache.
+static int g_fox_rb_swap = -1;
+static bool fox_rb_swap(void)
+{
+	if (g_fox_rb_swap < 0) {
+		char v[PROPERTY_VALUE_MAX];
+		g_fox_rb_swap = (property_get("ro.recovery.rb_swap", v, "") > 0 && v[0] == '1') ? 1 : 0;
+		printf("fox_rb_swap(gui): ro.recovery.rb_swap=%s -> %s\n", v[0] ? v : "(absent)",
+			g_fox_rb_swap ? "SWAP" : "no-swap");
+	}
+	return g_fox_rb_swap == 1;
+}
+
+// Pack a COLOR into the native uint32 pixel word. Stock order keeps blue in
+// bits 16-23; swapped families need red there instead (same ternary shape as
+// gr_render_circle in minuitwrp/graphics.cpp). The second arm is today's
+// expression verbatim, so absent/"0" output is bit-identical.
+static uint32_t fox_pack_color_a(COLOR color, unsigned int alpha)
+{
+	return fox_rb_swap() ? (uint32_t)((alpha << 24) | (color.red << 16) | (color.green << 8) | color.blue)
+		: (uint32_t)((alpha << 24) | (color.blue << 16) | (color.green << 8) | color.red);
+}
