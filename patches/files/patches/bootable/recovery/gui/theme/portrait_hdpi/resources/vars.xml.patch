--- a/bootable/recovery/gui/theme/portrait_hdpi/resources/vars.xml
+++ b/bootable/recovery/gui/theme/portrait_hdpi/resources/vars.xml
@@ -383,12 +383,33 @@
 		<!-- Battery -->
 		<variable name="battery_12_x" value="880-%status_indent_right%"/>
 		<variable name="battery_24_x" value="940-%status_indent_right%"/>
-		<variable name="battery_2_12_x" value="900-%status_indent_right%"/>
-		<variable name="battery_2_24_x" value="960-%status_indent_right%"/>
+		<!-- Fox: unified with pie/circle (were 900/960): with the
+		     clock on the right every style placed its percent text
+		     at its own x, so the text jumped 20px on style switch
+		     while the clock stayed put. The icon keeps its own slot;
+		     the text now ends at the same x in all styles.
+		     Center/right clock groups already share status_right_x
+		     and need no change. -->
+		<variable name="battery_2_12_x" value="880-%status_indent_right%"/>
+		<variable name="battery_2_24_x" value="940-%status_indent_right%"/>
 
 		<variable name="battery_y" value="%status_info_y%+6"/>
-		<variable name="battery_2_y" value="%status_info_y%+10"/>
+		<!-- Fox: +20 (was +10): the 62x31 style_2 glyph optically
+		     centers on the status text cap line (measured on shiba:
+		     text cap-center 71.5 at status_info_y=37, so slot top 56;
+		     +1 field refinement, icon sat 1px over the cap-top guide).
+		     +10 pinned the icon 9px above the text row while the text
+		     sits lowered by the status_h placement. Circle/dynamic
+		     styles are taller glyphs already bottom-anchored at the
+		     baseline — left authorial. -->
+		<variable name="battery_2_y" value="%status_info_y%+20"/>
 		<variable name="battery_circle_y" value="%status_info_y%+4"/>
+		<!-- Fox: style-independent percent-text row. GUIBattery drew
+		     the text Y from the icon slot, so the text jumped with
+		     every style (and never matched the clock row exactly).
+		     The code reads this var and draws the text here in all
+		     styles; the icon slot keeps its own geometry. -->
+		<variable name="battery_text_y" value="%status_info_y%"/>
 
 		<!-- File list -->
 		<variable name="fileselector_width" value="%screen_w%"/>
