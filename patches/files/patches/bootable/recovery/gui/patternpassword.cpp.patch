+void GUIPatternPassword::RebuildDotSurfaces()
+{
+	if (mDotCircle) {
+		gr_free_surface(mDotCircle);
+		mDotCircle = NULL;
+	}
+
+	if (mActiveDotCircle) {
+		gr_free_surface(mActiveDotCircle);
+		mActiveDotCircle = NULL;
+	}
+
+	if (mDotImage && mDotImage->GetResource() && mActiveDotImage && mActiveDotImage->GetResource()) {
+		return;
+	}
+
+	mDotCircle = gr_render_circle(mDotRadius, mDotColor.red, mDotColor.green, mDotColor.blue, mDotColor.alpha);
+	mActiveDotCircle = gr_render_circle(mDotRadius, mActiveDotColor.red, mActiveDotColor.green, mActiveDotColor.blue, mActiveDotColor.alpha);
+}
+
+void GUIPatternPassword::UpdateDotMetrics()
+{
+	// Image dots: radius comes from the asset. Hit radius still goes
+	// through the shared cell-based computation below so image dots keep
+	// a finger-sized touch target (stock used radius*3 here; a bare 1x
+	// radius would make image-dot unlock harder, not easier).
+	bool have_images = (mDotImage && mDotImage->GetResource() &&
+	                    mActiveDotImage && mActiveDotImage->GetResource());
+	if (have_images) {
+		mDotRadius = mDotImage->GetWidth();
+		mLineWidth = mBaseLineWidth;
+	} else {
+		mDotRadius = mBaseDotRadius;
+		mLineWidth = mBaseLineWidth;
+	}
+
+	if (mRenderW <= 0 || mRenderH <= 0 || mGridSize == 0) {
+		// Geometry unknown yet: preserve stock touch behavior.
+		mDotHitRadius = mDotRadius * 3;
+		return;
+	}
+
+	const int cell_w = std::max(1, mRenderW / static_cast<int>(mGridSize));
+	const int cell_h = std::max(1, mRenderH / static_cast<int>(mGridSize));
+	const int cell_min = std::min(cell_w, cell_h);
+
+	if (!have_images) {
+		// Shrink drawn dots on dense grids so neighbours stay separable.
+		int max_radius = mBaseDotRadius;
+		if (mGridSize >= 6) {
+			max_radius = cell_min / 5;
+		} else if (mGridSize >= 4) {
+			max_radius = cell_min / 4;
+		}
+		if (max_radius > 0) {
+			mDotRadius = std::max(16, std::min(mBaseDotRadius, max_radius));
+		}
+		mLineWidth = std::max(8, std::min(mBaseLineWidth, std::max(8, mDotRadius / 2)));
+	}
+
+	// Finger-sized hit target, capped at half a cell so neighbouring
+	// dots never overlap (stock radius*3 overlaps on dense grids).
+	mDotHitRadius = std::max(mDotRadius + 8, cell_min / 3);
+	mDotHitRadius = std::min(mDotHitRadius, std::max(16, cell_min / 2));
+}
