+// Fox: clear the two Pixel bootloader flags in misc vendor space the stock
+// wipe clears: dark theme (10 bytes at vendor offset) and preferred display
+// mode (32 bytes at +456), so the next boot starts neutral.
+static bool FoxClearMiscFlags(void) {
+	std::string err;
+	const std::string misc = get_misc_blk_device(&err);
+	if (misc.empty()) {
+		LOGERR("FoxFormat: unable to find misc: %s\n", err.c_str());
+		return false;
+	}
+	const char theme[10] = {};
+	const char display_mode[32] = {};
+	bool ok = true;
+	if (!write_misc_partition(theme, sizeof(theme), misc, VENDOR_SPACE_OFFSET_IN_MISC, &err)) {
+		LOGERR("FoxFormat: failed to clear the dark theme flag: %s\n", err.c_str());
+		ok = false;
+	}
+	if (!write_misc_partition(display_mode, sizeof(display_mode), misc,
+			VENDOR_SPACE_OFFSET_IN_MISC + 456, &err)) {
+		LOGERR("FoxFormat: failed to clear the preferred resolution: %s\n", err.c_str());
+		ok = false;
+	}
+	return ok;
+}
+
+// Fox: stock-mirror Format Data for multi-device /data. Recovery never builds
+// the f2fs here: once the start of userdata is blank, Android's vold formats
+// every device of the multi-device set on the next boot, as after a stock
+// factory reset. Unmap above is trivially clean (teardown removed the stack,
+// the sweep skip guards strays); merge check still runs like stock.
+// Fox: best-effort discard of one raw node (userdata companions). Missing
+// node = clean skip; anything else failing aborts: a half-dirty exp set
+// must not pass as wiped (fail closed).
+static bool FoxDiscardDevice(const char* path) {
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		if (errno == ENOENT) {
+			LOGINFO("FoxFormat: %s absent, skipping discard\n", path);
+			return true;
+		}
+		LOGERR("FoxFormat: cannot open %s: %s\n", path, strerror(errno));
+		return false;
+	}
+	uint64_t size = 0;
+	bool ok = (ioctl(fd, BLKGETSIZE64, &size) == 0 && size > 0);
+	if (ok) {
+		uint64_t range[2] = {0, size};
+		if (ioctl(fd, BLKSECDISCARD, &range) != 0
+				&& ioctl(fd, BLKDISCARD, &range) != 0)
+			ok = false;
+	}
+	if (!ok)
+		LOGERR("FoxFormat: unable to discard %s\n", path);
+	close(fd);
+	return ok;
+}
+
+// Fox: Titan M user-secret wipe via the tensor daemon (NUKE_FROM_ORBIT,
+// the same call the stock factory reset makes after data/metadata).
+// /dev/gsc0 serves one caller at a time, so the weaver service is stopped
+// first and restarted after. No per-generation branch: M1/M2/M3 share the
+// stable Nugget protocol; --check reads the firmware string for the log.
+static bool FoxWipeTitanM(void) {
+	android::base::SetProperty("ctl.stop", "recovery_weaver");
+	for (int i = 0; i < 5; i++) {
+		if (android::base::GetProperty("init.svc.recovery_weaver", "") == "stopped")
+			break;
+		sleep(1);
+	}
+	std::string output;
+	int rc = TWFunc::Exec_Cmd("/system/bin/recovery-tensor-daemon titan-wipe --erase", output, true);
+	LOGINFO("FoxFormat: titan-wipe output:\n%s", output.c_str());
+	android::base::SetProperty("ctl.start", "recovery_weaver");
+	if (rc != 0) {
+		LOGERR("FoxFormat: Titan M wipe failed\n");
+		return false;
+	}
+	LOGINFO("FoxFormat: wiped Titan M user secrets successfully\n");
+	return true;
+}
+
+// Fox: exact-geometry mkfs mirror of AOSP fs_mgr_format::format_f2fs
+// (recovery context): -g android, project_quota/casefold/compress flags
+// (+packed_ssa when the prop says so), -w/-b pagesize, -m iff a zoned
+// companion is present, -c per user_device with @alias for exp_alias,
+// NO sector count for multi-device sets, NO sload. Built over RAW by-name
+// nodes (stock-recovery-identical); the next-boot vold reformat through
+// the fresh dm stack stays authoritative.
+// use_mapper=false: raw by-name nodes (stock recovery context).
+// use_mapper=true:  live dm-crypt nodes (vold context — exact vold args,
+// primary included). Superblock stores the paths as passed.
+static bool FoxBuildMkfsCommand(const FoxDataDevices& dd, const std::string& primary,
+		bool use_mapper, std::string& out) {
+	out = "/system/bin/make_f2fs -g android";
+	out += " -O project_quota,extra_attr";
+	if (android::base::GetBoolProperty("external_storage.casefold.enabled", false))
+		out += " -O casefold -C utf8";
+	if (android::base::GetBoolProperty("vold.has_compress", false))
+		out += " -O compression,extra_attr";
+	if (android::base::GetBoolProperty("external_storage.packedssa.enabled", false))
+		out += " -O packed_ssa";
+	const std::string blk = std::to_string(getpagesize());
+	out += " -w " + blk + " -b " + blk;
+	if (dd.is_zoned)
+		out += " -m";
+	for (size_t i = 0; i < dd.devices.size(); i++) {
+		std::string leaf = dd.devices[i].substr(dd.devices[i].find_last_of('/') + 1);
+		std::string dn = use_mapper ? ("/dev/block/mapper/" + leaf) : dd.devices[i];
+		out += " -c ";
+		if (i < dd.aliased.size() && dd.aliased[i])
+			dn += "@" + leaf;
+		out += dn;
+	}
+	out += " " + primary;
+	return true;
+}
+
+// Fox: route (a) — build the fs in recovery, verify by mounting it right
+// here, unmount. The kernel opens the stored by-name paths (all present),
+// no dm nodes needed. Returns true only if mkfs+mount+unmount all succeed.
+static bool FoxMkfsAndVerify(const FoxDataDevices& dd, const std::string& primary,
+		bool via_mapper) {
+	if (!TWFunc::Path_Exists("/system/bin/make_f2fs")) {
+		LOGERR("FoxFormat: no make_f2fs, route (a) unavailable\n");
+		return false;
+	}
+	std::string cmd;
+	FoxBuildMkfsCommand(dd, primary, via_mapper, cmd);
+	LOGINFO("FoxFormat: mkfs cmd: %s\n", cmd.c_str());
+	if (TWFunc::Exec_Cmd(cmd) != 0) {
+		LOGERR("FoxFormat: mkfs failed, falling back\n");
+		return false;
+	}
+	const char* mnt = "/tmp/fox_mnt_verify";
+	mkdir(mnt, 0755);
+	bool ok = false;
+	if (::mount(primary.c_str(), mnt, "f2fs", 0, "") == 0) {
+		LOGINFO("FoxFormat: fresh fs mounts cleanly — geometry verified\n");
+		ok = (::umount2(mnt, 0) == 0);
+		if (!ok)
+			LOGERR("FoxFormat: cannot unmount verify mount: %s\n", strerror(errno));
+	} else {
+		LOGERR("FoxFormat: fresh fs failed to mount (%s) — geometry rejected, falling back\n",
+			strerror(errno));
+	}
+	rmdir(mnt);
+	return ok;
+}
