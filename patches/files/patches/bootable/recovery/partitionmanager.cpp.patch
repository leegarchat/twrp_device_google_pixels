+// Fox: stock-mirror userdata erase (discard + blank verification). Only ever
+// the raw userdata partition itself: realpath must resolve to
+// /dev/block/by-name/userdata and never under /dev/block/dm-. discard is
+// BLKSECDISCARD first, plain BLKDISCARD + zeroed first 4 KiB when the device
+// cannot do that; *blank reports whether the first 4 KiB read back as
+// zeros — the header kill that tells Android's vold to format the
+// multi-device set on the next boot. Read-back prefers O_DIRECT (past the
+// page cache); a plain-read fallback is used and logged when O_DIRECT is
+// unavailable. This verifies the header kill only, never the whole wipe.
+static bool FoxEraseUserdata(const std::string& device, bool* blank) {
+	*blank = false;
+	std::string path;
+	struct stat st, userdata_st;
+	if (!android::base::Realpath(device, &path) || stat(path.c_str(), &st) != 0
+			|| !S_ISBLK(st.st_mode) || path.compare(0, 15, "/dev/block/dm-") == 0
+			|| stat("/dev/block/by-name/userdata", &userdata_st) != 0
+			|| !S_ISBLK(userdata_st.st_mode) || st.st_rdev != userdata_st.st_rdev) {
+		LOGERR("FoxFormat: %s is not the raw userdata device. Nothing was erased.\n",
+			device.c_str());
+		return false;
+	}
+	int fd = open(path.c_str(), O_RDWR | O_CLOEXEC);
+	uint64_t size = 0;
+	if (fd < 0 || ioctl(fd, BLKGETSIZE64, &size) != 0 || size < 4096) {
+		LOGERR("FoxFormat: unable to open %s. Nothing was erased.\n", path.c_str());
+		if (fd >= 0)
+			close(fd);
+		return false;
+	}
+	uint64_t range[2] = {0, size};
+	bool discarded = (ioctl(fd, BLKSECDISCARD, &range) == 0);
+	if (!discarded) {
+		LOGINFO("FoxFormat: secure discard failed, used discard instead\n");
+		range[0] = 0;
+		range[1] = size;
+		discarded = (ioctl(fd, BLKDISCARD, &range) == 0);
+	}
+	if (!discarded) {
+		LOGERR("FoxFormat: unable to discard %s.\n", path.c_str());
+		close(fd);
+		return false;
+	}
+	// Always zero the header after any successful discard: secure discard
+	// does not promise zeros, and the header-kill read-back below must test
+	// what is actually on the medium.
+	const char zeros[4096] = {};
+	if (::pwrite(fd, zeros, sizeof(zeros), 0) != (ssize_t)sizeof(zeros)
+			|| ::fsync(fd) != 0) {
+		close(fd);
+		return true;  // discarded, but the header kill is unverified
+	}
+	int dfd = open(path.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+	bool direct = (dfd >= 0);
+	if (dfd < 0) {
+		// O_DIRECT unsupported here: fall back to a plain read. It can hit
+		// the page cache, so a pass proves less — logged honestly.
+		LOGINFO("FoxFormat: O_DIRECT unavailable (%s), verifying through page cache\n",
+			strerror(errno));
+		dfd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+	}
+	void* buf = NULL;
+	bool zeros_ok = false;
+	if (dfd >= 0 && posix_memalign(&buf, 4096, 4096) == 0) {
+		ssize_t n;
+		do {
+			n = ::pread(dfd, buf, 4096, 0);
+		} while (n < 0 && errno == EINTR);
+		zeros_ok = (n == 4096);
+		uint8_t* bytes = static_cast<uint8_t*>(buf);
+		for (int i = 0; zeros_ok && i < 4096; i++)
+			zeros_ok = (bytes[i] == 0);
+		free(buf);
+	}
+	if (dfd >= 0)
+		close(dfd);
+	close(fd);
+	*blank = zeros_ok;
+	if (zeros_ok && !direct)
+		LOGINFO("FoxFormat: header reads back zero (page-cache read, weaker proof)\n");
+	return true;
+}
