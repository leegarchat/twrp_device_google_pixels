+string TWPartitionManager::Get_Booted_Slot_Suffix() {
+	// Physical booted slot via the bootctrl HAL binary. resetprop and
+	// /proc bind-mount spoofing cannot move it, so installers must use
+	// this (never ro.boot.*) to decide whether a target is the LIVE slot.
+	// Fail-closed: "" means "unknown, refuse".
+	FILE* p = popen("/system/bin/bootctl get-current-slot 2>/dev/null", "r");
+	if (!p)
+		return "";
+	char buf[16] = {0};
+	bool ok = (fgets(buf, sizeof(buf), p) != nullptr);
+	pclose(p);
+	if (!ok)
+		return "";
+	string s(buf);
+	size_t end = s.find_last_not_of(" \t\r\n");
+	if (end == string::npos)
+		return "";
+	s.erase(end + 1);
+	if (s == "0")
+		return "_a";
+	if (s == "1")
+		return "_b";
+	return "";
+}
+
+string TWPartitionManager::Get_Booted_Slot_Display() {
+	string s = Get_Booted_Slot_Suffix();
+	if (s == "_a")
+		return "A";
+	if (s == "_b")
+		return "B";
+	return "";
+}
+
+// Forward declaration (defined further below next to Unmap_Super_Devices).
+static bool DestroyLogicalPartition_Retry(const std::string& name);
+
+// Spoof one slot-token file (/proc/cmdline, /proc/bootconfig) with a bind
+// mount. Edits always start from the pristine copy saved on the first
+// spoof, so switching back and forth never stacks edits.
+static bool Spoof_Slot_File(const string& path, const string& new_suffix) {
+	const char* slash = strrchr(path.c_str(), '/');
+	const string name = slash ? slash + 1 : path;
+	const string stage = "/tmp/fox_slotspoof";
+	mkdir(stage.c_str(), 0755);
+	const string orig = stage + "/orig_" + name;
+	const string edited = stage + "/new_" + name;
+	struct stat st;
+	string content;
+	if (stat(orig.c_str(), &st) == 0) {
+		FILE* f = fopen(orig.c_str(), "r");
+		if (!f)
+			return false;
+		char buf[8192];
+		size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+		fclose(f);
+		buf[n] = '\0';
+		content = buf;
+	} else {
+		FILE* f = fopen(path.c_str(), "r");
+		if (!f) {
+			LOGINFO("Live_Switch_Slot: no %s, skipping spoof\n", path.c_str());
+			return true;
+		}
+		char buf[8192];
+		size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+		fclose(f);
+		buf[n] = '\0';
+		content = buf;
+		FILE* o = fopen(orig.c_str(), "w");
+		if (!o)
+			return false;
+		fwrite(content.c_str(), 1, content.size(), o);
+		fclose(o);
+	}
+	static const char* pres[] = {
+		"androidboot.slot_suffix=",
+		"androidboot.slot=",
+		"androidboot.slot_suffix = \"",
+	};
+	bool found = false;
+	for (size_t t = 0; t < sizeof(pres) / sizeof(pres[0]); t++) {
+		string pre(pres[t]);
+		size_t pos = 0;
+		while ((pos = content.find(pre, pos)) != string::npos) {
+			size_t v = pos + pre.size();
+			if (content.compare(v, 2, "_a") == 0 || content.compare(v, 2, "_b") == 0) {
+				found = true;
+				if (content.compare(v, 2, new_suffix) != 0)
+					content.replace(v, 2, new_suffix);
+				pos = v + 2;
+				continue;
+			}
+			pos = v;
+		}
+	}
+	if (!found) {
+		LOGINFO("Live_Switch_Slot: no slot tokens in %s, skipping spoof\n", path.c_str());
+		return true;
+	}
+	LOGINFO("Live_Switch_Slot: spoofing %s to %s\n", path.c_str(), new_suffix.c_str());
+	FILE* o = fopen(edited.c_str(), "w");
+	if (!o)
+		return false;
+	fwrite(content.c_str(), 1, content.size(), o);
+	fclose(o);
+	if (mount(edited.c_str(), path.c_str(), nullptr, MS_BIND, nullptr) != 0) {
+		LOGERR("Live_Switch_Slot: bind mount %s failed: %s\n", path.c_str(), strerror(errno));
+		return false;
+	}
+	LOGINFO("Live_Switch_Slot: spoofed %s to %s\n", path.c_str(), new_suffix.c_str());
+	return true;
+}
+
+bool TWPartitionManager::Live_Switch_Slot(const string& Slot) {
+	if (Slot != "A" && Slot != "B") {
+		LOGERR("Live_Switch_Slot invalid slot '%s'\n", Slot.c_str());
+		return false;
+	}
+	string old_suffix = Get_Active_Slot_Suffix();
+	string new_suffix = (Slot == "A") ? "_a" : "_b";
+	LOGINFO("Live_Switch_Slot %s (session was %s)\n", Slot.c_str(), Active_Slot_Display.c_str());
+
+	Set_Active_Slot(Slot);
+	if (Get_Active_Slot_Display() != Slot) {
+		LOGERR("Live_Switch_Slot: display verify failed\n");
+		return false;
+	}
+
+	// Mounts taken down below, to remount after the new slot is mapped.
+	std::vector<string> unmounted_here;
+
+	{
+		FILE* f = fopen("/proc/mounts", "r");
+		if (f) {
+			char line[1024];
+			std::vector<string> mnts;
+			while (fgets(line, sizeof(line), f)) {
+				char src[512], mnt[512];
+				if (sscanf(line, "%511s %511s", src, mnt) != 2)
+					continue;
+				string s(src), m(mnt);
+				bool is_mapper = (s.compare(0, 19, "/dev/block/mapper/") == 0);
+				bool is_dm = is_mapper || (s.compare(0, 8, "/dev/dm-") == 0);
+				if (!is_dm || m.empty() || m == "/")
+					continue;
+				auto starts_with = [](const string& v, const char* p) {
+					return v.compare(0, strlen(p), p) == 0;
+				};
+				if (m == "/tmp" || m == "/data" || m == "/sdcard" || m == "/persist" || m == "/cache"
+					|| starts_with(m, "/persist/") || starts_with(m, "/data/") || starts_with(m, "/sdcard/")
+					|| starts_with(m, "/usb-otg") || starts_with(m, "/external_sd") || starts_with(m, "/efs")
+					|| starts_with(m, "/dev/") || starts_with(m, "/proc/") || starts_with(m, "/sys/"))
+					continue;
+				if (is_mapper) {
+					size_t slash = s.find_last_of('/');
+					string base = (slash == string::npos) ? s : s.substr(slash + 1);
+					if (base.size() >= 2 && base.compare(base.size() - 2, 2, new_suffix) == 0)
+						continue;
+				}
+				mnts.push_back(m);
+			}
+			fclose(f);
+			sort(mnts.begin(), mnts.end(), [](const string& a, const string& b) { return a.size() > b.size(); });
+			mnts.erase(unique(mnts.begin(), mnts.end()), mnts.end());
+			for (size_t i = 0; i < mnts.size(); i++) {
+				if (umount(mnts[i].c_str()) == 0 || umount2(mnts[i].c_str(), MNT_DETACH) == 0) {
+					LOGINFO("Live_Switch_Slot: unmounted %s\n", mnts[i].c_str());
+					unmounted_here.push_back(mnts[i]);
+				} else
+					LOGINFO("Live_Switch_Slot: keep %s (busy, harmless)\n", mnts[i].c_str());
+			}
+		}
+	}
+
+	{
+		DIR* d = opendir("/dev/block/mapper");
+		if (d) {
+			struct dirent* de;
+			while ((de = readdir(d)) != NULL) {
+				string n(de->d_name);
+				if (n == "." || n == ".." || n == "by-uuid")
+					continue;
+				if (n == "userdata" || n.compare(0, 12, "userdata_exp") == 0 || n == "zoned_device")
+					continue;
+				if (n.size() >= 2 && n.compare(n.size() - 2, 2, new_suffix) == 0)
+					continue;
+				string full = string("/dev/block/mapper/") + n;
+				char link[PATH_MAX];
+				ssize_t len = readlink(full.c_str(), link, sizeof(link) - 1);
+				if (len > 0) {
+					link[len] = '\0';
+					string tgt(link);
+					size_t slash = tgt.find_last_of('/');
+					string base = (slash == string::npos) ? tgt : tgt.substr(slash + 1);
+					if (base.compare(0, 3, "dm-") != 0) {
+						LOGINFO("Live_Switch_Slot: skip alias %s\n", n.c_str());
+						continue;
+					}
+				}
+				if (DestroyLogicalPartition_Retry(n))
+					LOGINFO("Live_Switch_Slot: unmapped stale %s\n", n.c_str());
+				else
+					LOGINFO("Live_Switch_Slot: keep %s (busy or foreign, harmless)\n", n.c_str());
+			}
+			closedir(d);
+		}
+	}
+
+	{
+		string cmd = string("/sbin/resetprop ro.boot.slot_suffix ") + new_suffix + " >/dev/null 2>&1";
+		int rc = system(cmd.c_str());
+		if (rc != 0) {
+			cmd = string("/system/bin/resetprop ro.boot.slot_suffix ") + new_suffix + " >/dev/null 2>&1";
+			rc = system(cmd.c_str());
+			if (rc != 0)
+				LOGERR("Live_Switch_Slot: resetprop missing/failed, props stay booted truth\n");
+		}
+		if (rc == 0)
+			LOGINFO("Live_Switch_Slot: spoofed ro.boot.slot_suffix=%s\n", new_suffix.c_str());
+		Spoof_Slot_File("/proc/cmdline", new_suffix);
+		Spoof_Slot_File("/proc/bootconfig", new_suffix);
+	}
+
+	if (android::base::GetBoolProperty("ro.virtual_ab.enabled", false)) {
+		Unlock_Block_Partitions();
+	}
+	// Map the new slot's volumes via siw (the designated LP channel):
+	// Mount_By_Path would trigger FoxRescan first, which drops objects
+	// whose dm nodes do not exist yet — before mount can materialize
+	// them (field case: empty mapper + "Unable to find partition").
+	// siw maps dm nodes directly without touching TWRP objects; the
+	// details refresh below then resolves sizes. Best-effort per volume.
+	{
+		const char* siw_bin = access("/system/bin/siw", X_OK) == 0
+			? "/system/bin/siw" : "siw";
+		for (std::vector<TWPartition*>::iterator it = Partitions.begin();
+				it != Partitions.end(); ++it) {
+			if (!(*it)->Is_Super)
+				continue;
+			string bare = Get_Bare_Partition_Name((*it)->Get_Mount_Point());
+			string full = bare + new_suffix;
+			string cmd = string(siw_bin) + " map --partition " + full
+				+ " --force-writable /dev/block/by-name/super 2>&1";
+			FILE* sp = popen(cmd.c_str(), "r");
+			string out;
+			if (sp) {
+				char buf[256];
+				while (fgets(buf, sizeof(buf), sp))
+					out += buf;
+				int rc = pclose(sp);
+				if (rc == 0 || out.find("already mapped") != string::npos)
+					LOGINFO("Live_Switch_Slot: mapped %s\n", full.c_str());
+				else
+					LOGINFO("Live_Switch_Slot: map %s failed (%s)\n",
+						full.c_str(), out.c_str());
+			} else {
+				LOGINFO("Live_Switch_Slot: cannot run siw for %s\n", full.c_str());
+			}
+		}
+	}
+	// Restore the pre-switch mounts (now resolving to the new slot).
+	for (size_t i = 0; i < unmounted_here.size(); i++) {
+		if (PartitionManager.Mount_By_Path(unmounted_here[i], false))
+			LOGINFO("Live_Switch_Slot: remounted %s\n", unmounted_here[i].c_str());
+		else
+			LOGINFO("Live_Switch_Slot: keep %s unmounted (harmless)\n", unmounted_here[i].c_str());
+	}
+	Update_System_Details();
+	LOGINFO("Live_Switch_Slot %s done\n", Slot.c_str());
+	return true;
+}
