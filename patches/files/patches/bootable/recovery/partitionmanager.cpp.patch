+// OFOX: destroy a logical partition tolerantly. The stock single-shot
+// DestroyLogicalPartition fails with EBUSY when the node is still mounted
+// (our own fw/ko staging mounts, vold/ueventd probes) or transiently open,
+// which used to fail the whole format with "Unable to unmap dynamic
+// partitions" until a manual retry. Unmount (lazy fallback) + retries.
+static bool FoxRemoveDmDevice(const std::string& name);
+
+// Fox: true when a dm device with this kernel name exists right now.
+// Device-mapper minors are recycled (field case: by-name/vendor stuck at a
+// dead dm-0 while vendor_a lives on dm-5), so cached dm-N paths prove
+// nothing — the kernel name under /sys/block/dm-*/dm/name is the truth,
+// the same source the dm-watch service publishes to /tmp/fox_dm_state.
+// Pure sysfs scan, no libdm linkage needed.
+static bool FoxDmDeviceExists(const std::string& name) {
+	DIR* d = opendir("/sys/block");
+	if (d == NULL)
+		return false;
+	struct dirent* de;
+	char namebuf[128];
+	while ((de = readdir(d)) != NULL) {
+		if (strncmp(de->d_name, "dm-", 3) != 0)
+			continue;
+		std::string f = std::string("/sys/block/") + de->d_name + "/dm/name";
+		FILE* fp = fopen(f.c_str(), "r");
+		if (!fp)
+			continue;
+		bool hit = (fgets(namebuf, sizeof(namebuf), fp) != NULL
+			&& strncmp(namebuf, name.c_str(), name.size()) == 0
+			&& (namebuf[name.size()] == '\n' || namebuf[name.size()] == '\0'));
+		fclose(fp);
+		if (hit) {
+			closedir(d);
+			return true;
+		}
+	}
+	closedir(d);
+	return false;
+}
+
+// Fox: stable_partition predicate — super volumes sort before everything.
+// Static member (TWPartitionManager is a friend of TWPartition, so Is_Super
+// is visible here; a free function is not).
+bool TWPartitionManager::Fox_Is_Super_Partition(TWPartition* p) {
+	return p != NULL && p->Is_Super;
+}
+
+// Fox: live dm kernel names right now (one per /sys/block/dm-*/dm/name).
+// Same truth as FoxDmDeviceExists, in bulk for the rescan below.
+static std::vector<std::string> FoxLiveDmNames(void) {
+	std::vector<std::string> names;
+	DIR* d = opendir("/sys/block");
+	if (d == NULL)
+		return names;
+	struct dirent* de;
+	char namebuf[128];
+	while ((de = readdir(d)) != NULL) {
+		if (strncmp(de->d_name, "dm-", 3) != 0)
+			continue;
+		std::string f = std::string("/sys/block/") + de->d_name + "/dm/name";
+		FILE* fp = fopen(f.c_str(), "r");
+		if (!fp)
+			continue;
+		if (fgets(namebuf, sizeof(namebuf), fp) != NULL) {
+			std::string n = namebuf;
+			while (!n.empty() && (n.back() == '\n' || n.back() == '\r'))
+				n.pop_back();
+			if (!n.empty())
+				names.push_back(n);
+		}
+		fclose(fp);
+	}
+	closedir(d);
+	return names;
+}
+
+// Fox: runtime dm truth interception (see declaration in partitions.hpp).
+// Unmap_Super_Devices ERASES Is_Super objects from the Partitions vector,
+// and first-stage/staging churn (handoff teardown, siw map/unmap, ueventd
+// races) invalidates cached dm-N paths — so a dm device mapped AFTER
+// startup (field case: manual `siw map` after Unmap, keep-listed vendor
+// nodes) has no TWRP object and the mount menu, backup and Mount() all
+// report "unable to find partition" even though the kernel device is live.
+// Runs at the top of Update_System_Details, Get_Partition_List and
+// Mount_By_Path: every live dm device whose LP base exists in
+// /etc/recovery.fstab but has no TWRP object gets one replayed from its
+// fstab line (same per-line flow as Process_Fstab: Process_Fstab_Line +
+// Prepare_Super_Volume). Covers ALL dm blocks generically (bare-name match
+// on `logical` lines, slot suffix stripped; system -> /system_root via
+// Get_Android_Root_Path). Never deletes: a stale object with a dead path
+// fails Mount gracefully and is cleaned by the next Unmap.
+void TWPartitionManager::Fox_Rescan_Super_Volumes(void) {
+	std::vector<std::string> live = FoxLiveDmNames();
+	// Live bare bases (slot suffix stripped) for the delete-pass below.
+	std::vector<std::string> live_bares;
+	if (!live.empty()) {
+		for (size_t i = 0; i < live.size(); i++) {
+			std::string bare = live[i];
+			if (bare.size() > 4 && bare.compare(bare.size() - 4, 4, "-cow") == 0)
+				continue;
+			size_t n = bare.size();
+			if (n > 2 && bare[n - 2] == '_' && (bare[n - 1] == 'a' || bare[n - 1] == 'b'))
+				bare.erase(n - 2);
+			if (std::find(live_bares.begin(), live_bares.end(), bare) == live_bares.end())
+				live_bares.push_back(bare);
+		}
+	}
+	bool changed = false;
+	// Delete-pass: drop Is_Super objects whose dm device is gone behind
+	// TWRP's back (field case: manual `siw unmap` leaves a dead menu entry
+	// that no update trigger cleans). Only unmounted ones — a mounted
+	// node is busy by definition and siw refuses to remove it anyway.
+	// Never touches non-super partitions.
+	for (std::vector<TWPartition*>::iterator it = Partitions.begin();
+			it != Partitions.end();) {
+		TWPartition* p = *it;
+		bool drop = false;
+		if (p->Is_Super && !p->Is_Mounted()) {
+			std::string bare = Get_Bare_Partition_Name(p->Get_Mount_Point());
+			if (std::find(live_bares.begin(), live_bares.end(), bare)
+					== live_bares.end())
+				drop = true;
+		}
+		if (drop) {
+			LOGINFO("FoxRescan: dropping %s (dm device gone)\n",
+				p->Get_Mount_Point().c_str());
+			delete p;
+			it = Partitions.erase(it);
+			changed = true;
+		} else {
+			++it;
+		}
+	}
+	if (live.empty()) {
+		if (changed)
+			Write_Fstab();
+		return;
+	}
+	// Fast path: every live device already has an object — nothing to do,
+	// and the fstab is never even opened.
+	bool missing = false;
+	std::vector<std::string> bares;
+	bares.reserve(live.size());
+	for (size_t i = 0; i < live.size(); i++) {
+		std::string bare = live[i];
+		// Skip snapshot leftovers, never LP devices.
+		if (bare.size() > 4 && bare.compare(bare.size() - 4, 4, "-cow") == 0)
+			continue;
+		// Strip the slot suffix (system_a -> system); slotless keeps
+		// its full name.
+		size_t n = bare.size();
+		if (n > 2 && bare[n - 2] == '_' && (bare[n - 1] == 'a' || bare[n - 1] == 'b'))
+			bare.erase(n - 2);
+		bares.push_back(bare);
+		std::string mnt = (bare == "system")
+			? Get_Android_Root_Path()
+			: "/" + bare;
+		if (Find_Partition_By_Path(mnt) == NULL)
+			missing = true;
+	}
+	if (!missing)
+		return;
+	// Build bare-name -> fstab-line map for `logical` entries only.
+	std::map<std::string, std::string> logical_lines;
+	FILE* fstabFile = fopen("/etc/recovery.fstab", "rt");
+	if (fstabFile == NULL)
+		return;
+	char fstab_line[MAX_FSTAB_LINE_LENGTH];
+	while (fgets(fstab_line, sizeof(fstab_line), fstabFile) != NULL) {
+		if (fstab_line[0] == '#' || strstr(fstab_line, "swap") != NULL)
+			continue;
+		if (strstr(fstab_line, "logical") == NULL)
+			continue;
+		// First whitespace-separated token is the LP base name.
+		size_t k = 0;
+		while (fstab_line[k] != '\0' && fstab_line[k] > 32)
+			k++;
+		if (k == 0)
+			continue;
+		logical_lines[std::string(fstab_line, k)] = fstab_line;
+	}
+	fclose(fstabFile);
+	if (logical_lines.empty())
+		return;
+	for (size_t i = 0; i < bares.size(); i++) {
+		const std::string& bare = bares[i];
+		std::string mnt = (bare == "system")
+			? Get_Android_Root_Path()
+			: "/" + bare;
+		if (Find_Partition_By_Path(mnt) != NULL)
+			continue;
+		std::map<std::string, std::string>::iterator it = logical_lines.find(bare);
+		if (it == logical_lines.end())
+			continue;
+		TWPartition* partition = new TWPartition();
+		// Process_Fstab_Line takes const char*; NULL flags = stock fallback.
+		if (partition->Process_Fstab_Line(it->second.c_str(), false, NULL)) {
+			if (partition->Is_Super && !Prepare_Super_Volume(partition)) {
+				delete partition;
+				continue;
+			}
+			// Fox: super volumes live at the very top (mount menu and
+			// /etc/fstab both follow vector order) — insert into the
+			// super block, not at the tail.
+			if (partition->Is_Super) {
+				std::vector<TWPartition*>::iterator pos = Partitions.begin();
+				while (pos != Partitions.end() && (*pos)->Is_Super)
+					++pos;
+				Partitions.insert(pos, partition);
+			} else {
+				Partitions.push_back(partition);
+			}
+			changed = true;
+			LOGINFO("FoxRescan: re-added %s for live dm device %s\n",
+				mnt.c_str(), live[i].c_str());
+		} else {
+			delete partition;
+		}
+	}
+	// Fox: stable super-first order for the whole vector (mount menu and
+	// Write_Fstab follow it). Covers the startup order too — Process_Fstab
+	// calls this rescan before returning.
+	std::stable_partition(Partitions.begin(), Partitions.end(),
+		Fox_Is_Super_Partition);
+	if (changed)
+		Write_Fstab();
+}
+
+static bool DestroyLogicalPartition_Retry(const std::string& name) {
+	std::string path = "/dev/block/mapper/" + name;
+	// Fox: destroying a name with no live dm device is a no-op success
+	// (field case: vendor_a never (re)mapped after the first-stage handoff
+	// tore it down — failing the whole Unmap/format over an already-gone
+	// node is wrong). A live-but-held node still goes through the retry
+	// path below and fails EBUSY, as it should.
+	if (!FoxDmDeviceExists(name)) {
+		LOGINFO("logical partition %s has no live dm device, skipping\n", name.c_str());
+		return true;
+	}
+	umount2(path.c_str(), 0);
+	umount2(path.c_str(), MNT_DETACH);
+	for (int i = 0; i < 5; i++) {
+		if (DestroyLogicalPartition(name)) {
+			if (i > 0)
+				LOGINFO("destroyed logical partition %s on attempt %d\n", name.c_str(), i + 1);
+			return true;
+		}
+		LOGINFO("destroy logical partition %s failed (attempt %d), retrying\n", name.c_str(), i + 1);
+		sleep(1);
+		umount2(path.c_str(), MNT_DETACH);
+	}
+	// Fox (malibu format-data, grizzly exp nodes): the mapper sweep can hit
+	// a dm node with NO LP metadata entry (field cases: bare vendor_dlkm
+	// on grizzly while metadata holds vendor_dlkm_b; userdata_exp.ai_256m
+	// and siblings with no usable LP record — creator unknown, node is
+	// real). liblp answers ENOENT/ENXIO, or EINVAL when it refuses the
+	// node outright; retrying liblp is futile either way. Remove the
+	// device directly via DM_DEV_REMOVE so one stray node no longer fails
+	// the whole format ("Unable to unmap dynamic partitions"). A
+	// mounted/in-use node still fails EBUSY (correct); anything else
+	// fails loudly below with its errno preserved for the log.
+	if (errno == ENOENT || errno == ENXIO || errno == EINVAL) {
+		LOGINFO("no LP entry for %s (liblp errno=%d %s), removing dm device directly\n",
+			name.c_str(), errno, strerror(errno));
+		if (FoxRemoveDmDevice(name))
+			return true;
+	}
+	LOGERR("destroy logical partition %s failed after retries: %s\n", name.c_str(), strerror(errno));
+	return false;
+}
+
+// Fox: direct DM_DEV_REMOVE for mapper nodes liblp doesn't know about.
+// True when the device is gone (or was never there); false otherwise
+// (EBUSY keeps failing the format, as it should).
+static bool FoxRemoveDmDevice(const std::string& name) {
+	int fd = open("/dev/device-mapper", O_RDWR);
+	if (fd < 0) {
+		LOGERR("FoxRemoveDmDevice: cannot open /dev/device-mapper: %s\n", strerror(errno));
+		return false;
+	}
+	const size_t bufsize = sizeof(struct dm_ioctl) + 4096;
+	struct dm_ioctl* io = (struct dm_ioctl*)calloc(1, bufsize);
+	if (!io) {
+		close(fd);
+		return false;
+	}
+	// Stamp a floor version, not headers: kernels reject any ioctl whose
+	// user minor exceeds their own (EINVAL "ioctl interface mismatch";
+	// live case headers 4.48 vs 6.1/5.x stock kernels). A low stamp is
+	// accepted everywhere we boot (5.10 -> 6.12), and DM_DEV_REMOVE with
+	// a name-only payload needs no features, so nothing is lost.
+	io->version[0] = DM_VERSION_MAJOR;
+	io->version[1] = 0;
+	io->version[2] = 0;
+	io->data_size = bufsize;
+	io->data_start = sizeof(struct dm_ioctl);
+	snprintf(io->name, sizeof(io->name), "%s", name.c_str());
+	bool ok = ioctl(fd, DM_DEV_REMOVE, io) == 0;
+	int e = errno;
+	if (ok)
+		LOGINFO("FoxRemoveDmDevice: removed dm device %s directly (no LP entry)\n", name.c_str());
+	else
+		LOGERR("FoxRemoveDmDevice: remove %s failed: %s\n", name.c_str(), strerror(e));
+	free(io);
+	close(fd);
+	if (ok)
+		return true;
+	return e == ENOENT || e == ENXIO;
+}
+
+// Fox: stock first-stage fstab location for this hardware. The booted
+// slot's stock image always matches the hardware 1:1, so normally exactly
+// one non-fips family fstab exists next to the -fips/zram/persist motorcade.
+// Anything ambiguous (or a missing first_stage) yields "": legacy path.
+static std::string FoxStockFstabPath(void) {
+	const char* dirpath = "/first_stage_ramdisk/system/etc";
+	DIR* d = opendir(dirpath);
+	if (d == NULL)
+		return "";
+	std::string fam = android::base::GetProperty("ro.recovery.soc_family", "");
+	std::string exact, single, second;
+	struct dirent* de;
+	while ((de = readdir(d)) != NULL) {
+		std::string n = de->d_name;
+		if (n.compare(0, 6, "fstab.") != 0)
+			continue;
+		std::string suf = n.substr(6);
+		if (suf.empty() || suf.find("fips") != std::string::npos
+				|| suf.find("zram") != std::string::npos || suf.find("persist") != std::string::npos
+				|| suf.find("efs") != std::string::npos || suf.find("modem") != std::string::npos)
+			continue;
+		if (!fam.empty() && suf == fam) {
+			exact = std::string(dirpath) + "/" + n;
+			break;
+		}
+		if (single.empty())
+			single = std::string(dirpath) + "/" + n;
+		else
+			second = std::string(dirpath) + "/" + n;
+	}
+	closedir(d);
+	if (!exact.empty())
+		return exact;
+	if (!single.empty() && second.empty())
+		return single;
+	return "";
+}
+
+// Fox: parse the live /data line's multi-device set (libfs_mgr
+// ParseUserDevices mirror). device=zoned|exp|exp_alias:<path> entries with a
+// node that exists on this unit form the set; missing nodes (zoned on some
+// SKUs, DFE-stripped units) are skipped loudly, never guessed.
+static FoxDataDevices FoxParseStockDataDevices(void) {
+	// Parsed fresh on every call (one small file): no stale snapshot across
+	// ueventd races, and guards in other translation units always see the
+	// live tree. First_stage is immutable for the booted slot.
+	FoxDataDevices out;
+	std::string path = FoxStockFstabPath();
+	if (path.empty()) {
+		LOGINFO("FoxFstab: no stock family fstab found\n");
+		return out;
+	}
+	FILE* f = fopen(path.c_str(), "r");
+	if (!f) {
+		LOGINFO("FoxFstab: cannot open %s\n", path.c_str());
+		return out;
+	}
+	LOGINFO("FoxFstab: parsing %s\n", path.c_str());
+	char linebuf[4096];
+	while (fgets(linebuf, sizeof(linebuf), f) != NULL) {
+		if (linebuf[0] == '#' || linebuf[0] == '\n')
+			continue;
+		// fields: src mnt fstype mnt_flags fs_mgr_flags...
+		std::istringstream iss(linebuf);
+		std::vector<std::string> fields;
+		std::string tok;
+		while (iss >> tok)
+			fields.push_back(tok);
+		if (fields.size() < 5 || fields[1] != "/data")
+			continue;
+		if (fields[2] != "f2fs")
+			continue;  // only the f2fs line carries the live device set
+		std::vector<std::string> flags = android::base::Split(fields[4], ",");
+		for (size_t i = 0; i < flags.size(); i++) {
+			if (flags[i].compare(0, 7, "device=") != 0)
+				continue;
+			std::string arg = flags[i].substr(7);
+			size_t colon = arg.find(':');
+			if (colon == std::string::npos) {
+				LOGINFO("FoxFstab: malformed device= flag '%s', skipping\n", flags[i].c_str());
+				continue;
+			}
+			std::string kind = arg.substr(0, colon), dev = arg.substr(colon + 1);
+			if (kind != "zoned")
+				out.declared_exp++;
+			if (kind != "zoned" && kind != "exp" && kind != "exp_alias") {
+				LOGERR("FoxFstab: unknown device kind '%s' — refusing to guess the set (fail closed)\n",
+					kind.c_str());
+				out.has_unknown = true;
+				continue;
+			}
+			if (access(dev.c_str(), F_OK) != 0) {
+				LOGINFO("FoxFstab: %s absent on this unit, skipping\n", dev.c_str());
+				continue;
+			}
+			if (kind == "zoned")
+				out.is_zoned = true;
+			else
+				out.has_exp = true;
+			out.devices.push_back(dev);
+			out.aliased.push_back(kind == "exp_alias" ? 1 : 0);
+			out.zoned.push_back(kind == "zoned" ? 1 : 0);
+		}
+		if (out.has_unknown)
+			break;
+		out.valid = true;
+		break;
+	}
+	fclose(f);
+	if (out.has_unknown) {
+		LOGERR("FoxFstab: unknown device kind present — set rejected (fail closed)\n");
+		out.valid = false;
+		out.devices.clear();
+		out.has_exp = false;
+	}
+	LOGINFO("FoxFstab: /data set: %zu device(s), zoned=%d, declared_exp=%d\n",
+		out.devices.size(), out.is_zoned ? 1 : 0, out.declared_exp);
+	return out;
+}
+
+// Fox: unmount every mount sourced from the crypto dm stack and everything
+// below /data//sdcard, children first, never lazy. A detached f2fs can write
+// its superblock back after the discard and Android would then miss the wipe,
+// so EINVAL/ENOENT (already gone) are tolerated but anything else — including
+// EBUSY — fails loudly: close whatever holds /data and retry, nothing is
+// destroyed before this returns true.
+static bool FoxUnmountDataStack(const std::vector<std::string>& dm_srcs) {
+	std::string text;
+	if (!android::base::ReadFileToString("/proc/self/mounts", &text)) {
+		LOGERR("FoxTeardown: unable to read /proc/self/mounts\n");
+		return false;
+	}
+	std::vector<std::string> targets;
+	std::istringstream ms(text);
+	std::string mline;
+	while (std::getline(ms, mline)) {
+		std::istringstream ls(mline);
+		std::string src, dir;
+		if (!(ls >> src >> dir))
+			continue;
+		bool ours = (dir == "/data" || dir.compare(0, 6, "/data/") == 0
+				|| dir == "/sdcard" || dir.compare(0, 8, "/sdcard/") == 0);
+		if (!ours) {
+			for (size_t i = 0; i < dm_srcs.size() && !ours; i++)
+				ours = (src == dm_srcs[i]);
+		}
+		if (ours)
+			targets.push_back(dir);
+	}
+	std::sort(targets.begin(), targets.end(),
+		[](const std::string& a, const std::string& b) { return a.size() > b.size(); });
+	for (size_t i = 0; i < targets.size(); i++) {
+		if (umount2(targets[i].c_str(), 0) != 0 && errno != EINVAL && errno != ENOENT) {
+			LOGERR("FoxTeardown: %s still in use (%s). Close whatever is using it and try again.\n",
+				targets[i].c_str(), strerror(errno));
+			return false;
+		}
+		LOGINFO("FoxTeardown: unmounted %s\n", targets[i].c_str());
+	}
+	return true;
+}
+
+// Fox: reverse-order teardown of the decrypted /data stack (multi-device
+// only; empty set = no-op). Attach is dm mappings first, mount last —
+// detach in reverse: unmount the stack, then remove the mappings top-down
+// (userdata first, then the parsed user_devices by mapper name). Anything
+// still held fails here, before the point of no return, so a half-torn
+// stack is impossible.
+// Fox: mapper names for the parsed set (userdata first, then user_devices
+// by by-name leaf — the dm name equals the by-name leaf on Pixels).
+static std::vector<std::string> FoxDmNames(const FoxDataDevices& dd) {
+	std::vector<std::string> names;
+	names.push_back("userdata");
+	for (size_t i = 0; i < dd.devices.size(); i++)
+		names.push_back(dd.devices[i].substr(dd.devices[i].find_last_of('/') + 1));
+	return names;
+}
+
+static std::vector<std::string> FoxDmSrcs(const FoxDataDevices& dd) {
+	std::vector<std::string> srcs;
+	std::vector<std::string> names = FoxDmNames(dd);
+	for (size_t i = 0; i < names.size(); i++)
+		srcs.push_back("/dev/block/mapper/" + names[i]);
+	return srcs;
+}
+
+// Fox: quiesce only — unmount the decrypted stack, no destruction. Fully
+// reversible (reboot or remount restores it); runs before the merge check so
+// that Unmap operates on an unmounted stack.
+static bool FoxQuiesceDataStack(const FoxDataDevices& dd) {
+	if (!dd.valid || !dd.has_exp)
+		return true;  // legacy single/zoned-only: untouched
+	return FoxUnmountDataStack(FoxDmSrcs(dd));
+}
+
+// Fox: destructive half — remove the dm mappings top-down (userdata first).
+// Runs only after the merge check passed: this is past the point of no
+// return for the in-memory stack (a reboot recreates it via decrypt, keys
+// are still in /metadata), but before the first truly irreversible step
+// (userdata discard).
+static bool FoxRemoveDataMappings(const FoxDataDevices& dd) {
+	if (!dd.valid || !dd.has_exp)
+		return true;  // legacy single/zoned-only: untouched
+	std::vector<std::string> names = FoxDmNames(dd);
+	// Safety net: fstab is the primary truth (immune to DFE/snapshots),
+	// but a live mapper node not in the parsed set (late ueventd, alias
+	// drift) must not survive either — union with the live scan.
+	DIR* d = opendir("/dev/block/mapper");
+	if (d != NULL) {
+		struct dirent* de;
+		while ((de = readdir(d)) != NULL) {
+			std::string n = de->d_name;
+			if (n != "zoned_device" && n.compare(0, 12, "userdata_exp") != 0)
+				continue;
+			bool known = false;
+			for (size_t i = 0; i < names.size() && !known; i++)
+				known = (names[i] == n);
+			if (!known) {
+				LOGINFO("FoxTeardown: live mapper %s not in fstab set, adding\n", n.c_str());
+				names.push_back(n);
+			}
+		}
+		closedir(d);
+	}
+	for (size_t i = 0; i < names.size(); i++) {
+		std::string mp = "/dev/block/mapper/" + names[i];
+		if (access(mp.c_str(), F_OK) != 0) {
+			LOGINFO("FoxTeardown: %s already gone, skipping\n", names[i].c_str());
+			continue;
+		}
+		LOGINFO("FoxTeardown: removing dm mapping %s\n", names[i].c_str());
+		if (!FoxRemoveDmDevice(names[i]))
+			return false;
+	}
+	return true;
+}
