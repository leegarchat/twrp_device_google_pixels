+    // need RGBA-order instead.
+    const uint32_t px = fox_rb_swap() ? (uint32_t)((a << 24) | (r << 16) | (g << 8) | b)
+                                      : (uint32_t)((a << 24) | (b << 16) | (g << 8) | r);
