+static int fbdev_max_brightness(const char* brightness_path)
+{
+    char max_path[256];
+    const char* slash = strrchr(brightness_path, '/');
+    int max_brightness = 0;
+
+    if (slash == NULL)
+        return 255;
+
+    int path_len = snprintf(max_path, sizeof(max_path), "%.*s/max_brightness",
+                            (int)(slash - brightness_path), brightness_path);
+    if (path_len < 0 || (size_t)path_len >= sizeof(max_path))
+        return 255;
+
+    FILE* max_file = fopen(max_path, "r");
+    if (max_file == NULL)
+        return 255;
+
+    if (fscanf(max_file, "%d", &max_brightness) != 1 || max_brightness <= 0)
+        max_brightness = 255;
+    fclose(max_file);
+    return max_brightness;
+}
