[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=installOrangeFox;

[Desktop Action installOrangeFox]
Name=Install with OrangeFox recovery installer
Comment=Flash this recovery payload via bootsmasher (overrides export.txt for one run)
Icon=drive-removable-media
Terminal=true
Exec=@INSTALLER_DIR@/install-desktop.sh %f
